{
  "name": "mira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MIRA \u2014 Know more. Move freely. Privacy-first pilot for DU North Campus.",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --port 3100",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build && npm run worker:build",
    "start": "next start --port 3100",
    "worker:dev": "tsx watch --conditions=react-server --tsconfig tsconfig.json src/worker/main.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:start": "node dist/worker.mjs",
    "env:local": "tsx scripts/env-local.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:new-migration": "tsx scripts/new-migration.ts",
    "pilot:fetch": "tsx scripts/fetch-pilot.ts",
    "pilot:import": "tsx scripts/import-pilot.ts",
    "admin:hash": "tsx scripts/admin-hash.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "postinstall": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "drizzle-orm": "0.45.3",
    "maplibre-gl": "6.11.2",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
