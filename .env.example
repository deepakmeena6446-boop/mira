# Public worldwide beta: set PUBLIC_BETA_STRICT=on on Railway web only after every
# advertised provider is configured; keep community publication off until staffed.
PUBLIC_BETA_STRICT=off

# MIRA environment contract (architecture §7). Copy values into your secret store for
# production. For local development run `npm run env:local`, which writes an ignored
# .env.local with fresh random secrets.

# --- Required ---------------------------------------------------------------
# PostgreSQL + PostGIS connection URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/mira
# Public origin of the web app (https:// in production). Used for invite links and CSRF.
APP_BASE_URL=https://mira.example.org
# At least 32 random bytes, base64-encoded (openssl rand -base64 32). Keys HMACs for
# session tokens and rate-limit counters.
SESSION_SECRET=
# Exactly 32 random bytes, base64-encoded (openssl rand -base64 32). AES-256-GCM key for
# private report text, journey destinations and contact emails.
DATA_ENCRYPTION_KEY=
# Argon2id hash of the moderator password (`npm run admin:hash`). No default exists.
# Use the "b64:..." form it prints: the raw "$argon2id$..." form is mangled by dotenv
# expansion if the variable also appears in any .env file.
ADMIN_PASSWORD_HASH=
# Path to the sourced pilot map manifest.
PILOT_MANIFEST_PATH=data/pilot/manifest.json
# Raster tile template. OSM standard tiles are acceptable only for low-volume pilot use;
# switch provider before scale (https://operations.osmfoundation.org/policies/tiles/).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional attribution override for a non-OSM tile provider.
MAP_TILE_ATTRIBUTION=

# Client IP for rate limits only (HMAC'd, never stored). If the platform's edge overwrites a
# single header with the connecting address, name it here: on Railway, "x-real-ip".
CLIENT_IP_HEADER=
# Otherwise: number of trusted proxies that append to X-Forwarded-For (default 1).
TRUSTED_PROXY_HOPS=1

# --- Required for PUBLIC_BETA_STRICT=on; optional for local previews: contact email (only automatic contact channel) ----------------
# With no provider, contact invitations, missed-arrival emails and email sign-in are off,
# the UI says so, and production logs a config.warning. Share links still work.
#
# Production: Resend's HTTPS API (no outbound SMTP needed). Verify your sending domain in
# Resend (SPF + DKIM) first; see docs/DEPLOY.md. Takes precedence over SMTP.
RESEND_API_KEY=
# Sender for every MIRA email, on the verified domain: MIRA <alerts@your-domain>
EMAIL_FROM=
#
# Local development / E2E: SMTP (Mailpit via docker compose). Used only when RESEND_API_KEY
# is unset. SMTP_FROM falls back to EMAIL_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# "true" for implicit TLS (port 465). STARTTLS is used automatically when offered.
SMTP_SECURE=

# --- Map basemap -------------------------------------------------------------
# Vector style URL (takes precedence over MAP_TILE_URL). Placeholder: OpenFreeMap (free, no key).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Optional night basemap (used from 8 pm to 5 am, or when Dark is pinned). Defaults to OpenFreeMap "dark".
# MAP_STYLE_URL_NIGHT=https://tiles.openfreemap.org/styles/dark
# OpenStreetMap services (server-side, ~100 m rounded, cached). Fallbacks when Google can't answer:
# area names (Nominatim) and destination search (Photon). Leave unset to turn off.
REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org
# Overpass: the "mapped as lit" lighting source and OSM Help Points (required for the public beta).
# Public servers are polite-use only: MIRA queues to ~1 request/s per process.
OVERPASS_URL=https://overpass-api.de/api/interpreter
PLACE_SEARCH_URL=https://photon.komoot.io

# --- Real providers (optional locally; required for the public beta) ---------
# MIRA runs fully on placeholders. Each key below switches on its real provider
# (see src/server/providers/modes.ts); a missing key degrades honestly and is logged at boot.
# Mira's brain (Claude): see the Mira block below.
# Google Maps Platform. Server key: Places API (New), Routes API, Geocoding API. Browser key: Map Tiles API
# (restrict it to your site). Unset = the free OpenStreetMap placeholder.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Optional street-lighting layer: streetlight poles from Mapillary street imagery (free token:
# mapillary.com/dashboard/developers). Unset = OpenStreetMap tags + MIRA walkers only.
MAPILLARY_TOKEN=

# Spend ceilings (optional; public defaults in code). Google calls per minute per web process
# (default 600): over it, maps answer from the OpenStreetMap fallback instead of failing.
# Mira messages per day across everyone (default 5000; each person is also capped at 60/day).
# Set Google Cloud quotas/budget alerts and an Anthropic spend limit as the hard backstop.
GOOGLE_MAX_CALLS_PER_MIN=
# Google calls per UTC day per web process (default 20000); over it, the same OpenStreetMap fallback.
GOOGLE_MAX_CALLS_PER_DAY=
MIRA_GLOBAL_DAILY_MAX=
# "on" = ask Google for Help Point opening hours (Places Enterprise SKU: higher cost). The owner approved "on"
# for MIRA (2026-09-26). Off: OpenStreetMap hours are still used, and Google Help Points say "hours not known".
GOOGLE_PLACES_HOURS=on

# Mira on Claude (claude-sonnet-5, low effort, streaming tools). Unset = the scripted placeholder.
ANTHROPIC_API_KEY=
# Mira's model (default claude-sonnet-5; measured 2026-09-26 with `npx tsx scripts/mira-eval.ts`, see docs/MIRA_EVAL.md).
# Switch without a code change (setting it redeploys on Railway), e.g. claude-opus-5.
MIRA_MODEL=
# Mira's tokens per day across everyone (input + output; default 2000000). Over it, Mira says she's resting
# and the scripted Mira answers until midnight UTC. Errors and timeouts also fall back to the scripted Mira.
MIRA_DAILY_TOKEN_MAX=
# Unused: there is no Mapbox adapter. Leave unset.
MAPBOX_TOKEN=
# "Continue with Google" sign-in (OpenID Connect, authorization code + PKCE; no SDK).
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → type "Web application".
#   Authorised JavaScript origins: your APP_BASE_URL (e.g. https://mira.example.org)
#   Authorised redirect URI (exactly):  ${APP_BASE_URL}/api/auth/google/callback
#     e.g. https://mira.example.org/api/auth/google/callback  (local: http://localhost:3100/api/auth/google/callback)
# OAuth consent screen scopes: openid, .../auth/userinfo.email, .../auth/userinfo.profile (non-sensitive; no verification needed).
# MIRA keeps only the Google account id, the first name, and the email as a keyed hash + encrypted copy.
# Set both or neither (startup fails on half a client). Both set = Google is the sign-in and first-name sign-in is switched off (unless ALLOW_DEMO_SIGNIN=on).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# "on" keeps first-name (demo) sign-in available alongside Google. Unset/off = Google (and email link) only.
# Refused when PUBLIC_BETA_STRICT=on (first-name accounts can't prove an email address).
# Without AUTH_GOOGLE_ID/SECRET, first-name sign-in is always available (local dev, tests).
ALLOW_DEMO_SIGNIN=
# Web Push to the traveller (missed check-in, contact accepted, location paused). Generate a pair with
# `npx web-push generate-vapid-keys` (npm run env:local does it for local dev). Subject: mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Safety updates (docs/SAFETY_UPDATES.md) ──
# "gdelt" (default): recent women-safety news for the city, from the GDELT index (keyless; only the city
# name is sent). "off": the section says it's switched off. "fixture": sample data for tests; refused in strict mode.
SAFETY_UPDATES=
# Model for the relevance check on ambiguous headlines (default claude-opus-5, low effort). Needs ANTHROPIC_API_KEY.
SAFETY_CLASSIFIER_MODEL=

# ── Contributions (docs/CONTRIBUTIONS.md) ──
# "on" lets the weekly job publish community notes from approved reports. Default off (fail safe):
# until moderation operations exist, reports stay private and no new public notes are published.
PUBLIC_AGGREGATE_RELEASES=off
# Local Steward thresholds (beta defaults: 25 verified, 10 active days, 3 areas, 80% agreement,
# 30-day-old account). Not final; leave empty for the defaults.
STEWARD_MIN_VERIFIED=
STEWARD_MIN_ACTIVE_DAYS=
STEWARD_MIN_AREAS=
STEWARD_MIN_AGREEMENT_PCT=
STEWARD_MIN_ACCOUNT_DAYS=
