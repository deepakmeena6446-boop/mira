# MIRA environment contract (architecture §7). Copy values into your secret store for
# production. For local development run `npm run env:local`, which writes an ignored
# .env.local with fresh random secrets.

# --- Required ---------------------------------------------------------------
# PostgreSQL + PostGIS connection URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/mira
# Public origin of the web app (https:// in production). Used for invite links and CSRF.
APP_BASE_URL=https://mira.example.org
# At least 32 random bytes, base64-encoded (openssl rand -base64 32). Keys HMACs for
# session tokens and rate-limit counters.
SESSION_SECRET=
# Exactly 32 random bytes, base64-encoded (openssl rand -base64 32). AES-256-GCM key for
# private report text, journey destinations and contact emails.
DATA_ENCRYPTION_KEY=
# Argon2id hash of the moderator password (`npm run admin:hash`). No default exists.
# Use the "b64:..." form it prints: the raw "$argon2id$..." form is mangled by dotenv
# expansion if the variable also appears in any .env file.
ADMIN_PASSWORD_HASH=
# Path to the sourced pilot map manifest.
PILOT_MANIFEST_PATH=data/pilot/manifest.json
# Raster tile template. OSM standard tiles are acceptable only for low-volume pilot use;
# switch provider before scale (https://operations.osmfoundation.org/policies/tiles/).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional attribution override for a non-OSM tile provider.
MAP_TILE_ATTRIBUTION=

# Number of trusted proxies that append to X-Forwarded-For (default 1). Used only to
# key rate limits (HMAC'd, never stored). Run behind a proxy that appends the client IP.
TRUSTED_PROXY_HOPS=1

# --- Optional: contact email (only automatic contact channel) ----------------
# When SMTP_HOST/SMTP_FROM are unset, contact invitations and alerts are disabled and
# the UI says so; check-in-only journeys still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# "true" for implicit TLS (port 465). STARTTLS is used automatically when offered.
SMTP_SECURE=

# --- Map basemap -------------------------------------------------------------
# Vector style URL (takes precedence over MAP_TILE_URL). Placeholder: OpenFreeMap (free, no key).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Optional night basemap (used from 8 pm to 5 am, or when Dark is pinned). Defaults to OpenFreeMap "dark".
# MAP_STYLE_URL_NIGHT=https://tiles.openfreemap.org/styles/dark
# Placeholder area names outside the local OSM snapshot (server-side, ~100 m rounded, cached).
# Leave unset to turn off. Replaced by Mapbox when MAPBOX_TOKEN is set.
REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org
# Placeholder nearby places (Overpass) and destination search (Photon) outside the snapshot.
OVERPASS_URL=https://overpass-api.de/api/interpreter
PLACE_SEARCH_URL=https://photon.komoot.io

# --- Real providers (optional) ------------------------------------------------
# MIRA runs fully on placeholders. These switch on real providers once their
# adapters are implemented (see src/server/providers/modes.ts).
# Mira's brain (Claude). Planned model: claude-opus-5, low effort, streaming + tools.
# Google Maps Platform. Server key: Places API (New), Routes API, Geocoding API. Browser key: Map Tiles API
# (restrict it to your site). Unset = the free OpenStreetMap placeholder.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# Optional street-lighting layer: streetlight poles from Mapillary street imagery (free token:
# mapillary.com/dashboard/developers). Unset = OpenStreetMap tags + MIRA walkers only.
MAPILLARY_TOKEN=

# Mira on Claude (claude-opus-5, low effort, streaming tools). Unset = the scripted placeholder.
ANTHROPIC_API_KEY=
# Maps, place search and walking directions.
MAPBOX_TOKEN=
# "Continue with Google" sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Web push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
